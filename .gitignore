# Independent release: publish only the selected PID tool and its dependencies.
# Upstream files not selected here stay on disk; they are not deleted.
/*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/requirements-motor-bo.txt
!/start_motor_gui.bat
!/motor_bo.py
!/motor_bo_hw.py
!/motor_bo_link.py
!/motor_bo_gui.py
!/motor_bo_config.json
!/motor_bo_hw_config.example.json
!/motor_bo_position_config.example.json
!/motor_bo_local.example.json

!/motor_bo_core/
/motor_bo_core/*
!/motor_bo_core/*.py

# Upstream LLM client and its transitive imports, retained with MIT notice.
!/llm/
/llm/*
!/llm/*.py
!/core/
/core/*
!/core/__init__.py
!/core/config.py
!/core/console.py
!/core/buffer.py
!/core/history.py
!/core/i18n.py
!/core/compat.py
!/pid_safety.py

!/tests/
/tests/*
!/tests/test_motor_bo*.py

!/docs/
/docs/*
!/docs/motor_bo_gui.md
!/docs/PROTOCOL.md
!/docs/PUBLISHING.md
!/docs/zh-CN/
/docs/zh-CN/*
!/docs/zh-CN/MOTOR_BO.md

!/images/
/images/*
!/images/speed-validation.svg

# Never publish local credentials, hardware settings, data or environments.
config.json
motor_bo_local.json
motor_bo_hw_config.json
motor_bo_gui_settings.json
motor_bo_terminal_latest.log
artifacts/
logs/
__pycache__/
*.py[cod]
venv/
venv_build/
env/
.venv/
.vscode/
.idea/
.claude/
build/
dist/
*.spec
*.log
